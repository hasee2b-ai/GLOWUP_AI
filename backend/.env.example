SENSENOVA_API_KEY=replace_with_your_new_api_key
SENSENOVA_BASE_URL=https://token.sensenova.ai/v1
SENSENOVA_IMAGE_MODEL=sensenova-u1.5-lite
SENSENOVA_IMAGE_ENDPOINT=/images/generations
